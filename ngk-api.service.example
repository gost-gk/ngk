[Unit]
Description=Gunicorn instance to serve gcode.space
After=network.target

[Service]
User=python
Group=www-data
WorkingDirectory=/home/python/ngk/src
ExecStart=/usr/local/bin/uwsgi --http :1234 --http-websockets --enable-threads --gevent 100 --http-websockets --master -w ngk.api --callable app

[Install]
WantedBy=multi-user.target
